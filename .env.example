# Copy to .env (never commit it). Every variable is optional except where marked for production.
STL_DATABASE_URL=sqlite:///./data/stl.db          # production: Supabase Postgres connection string
STL_DRY_RUN=true                                  # set false only after Meta setup is done

# Meta / WhatsApp Cloud API (production)
STL_WA_VERIFY_TOKEN=                              # any long random string you invent; paste the same in Meta
STL_WA_APP_SECRET=                                # App settings -> Basic -> App secret
STL_WA_ACCESS_TOKEN=                              # permanent System User token
STL_META_PAGE_TOKEN=                              # optional; leads_retrieval (same system-user token usually works)
STL_WA_PHONE_NUMBER_ID=                           # WhatsApp Manager -> API setup -> Phone number ID
STL_WA_BUSINESS_NUMBER=                           # digits only, e.g. 91XXXXXXXXXX (used in wa.me links)
STL_GRAPH_VERSION=v23.0                           # use the version shown in your Meta app dashboard
STL_ALLOW_PAID_TEMPLATES=false                    # free-only: keep false
STL_SERVICE_MSG_MONTHLY_CAP=950                   # automation pauses before the free monthly allowance

# Shop
STL_CATALOGUE_URL=                                # Google Drive PDF / website price list link
STL_SHOP_OPEN=09:30
STL_SHOP_CLOSE=20:30
STL_SHOP_CLOSED_DAYS=                             # e.g. sun
STL_SHOP_LAT=18.4553                              # replace with exact shop location from Google Maps
STL_SHOP_LON=73.9154

# Owners: Telegram (free, recommended) and optional WhatsApp numbers
STL_TELEGRAM_BOT_TOKEN=
STL_TELEGRAM_FATHER_CHAT=
STL_TELEGRAM_PAINTER_CHAT=
STL_TELEGRAM_HUSSAIN_CHAT=
STL_OWNER_FATHER_WA=
STL_OWNER_PAINTER_WA=
STL_OWNER_HUSSAIN_WA=

# Staff pages + cron
STL_PUBLIC_BASE_URL=https://your-service.onrender.com
STL_STAFF_USER=staff
STL_STAFF_PASSWORD=                               # required for /staff pages
STL_CRON_SECRET=                                  # header X-Cron-Secret for POST /cron/tick
STL_FORM_ALLOWED_ORIGINS=                         # e.g. https://unitedtrader.example
STL_LEADFORM_OPTIN_FIELD=whatsapp_opt_in

# Optional LLM classification (off when empty)
STL_LLM_API_KEY=
STL_LLM_BASE_URL=https://api.openai.com/v1
STL_LLM_MODEL=gpt-4o-mini
